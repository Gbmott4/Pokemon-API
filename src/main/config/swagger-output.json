{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "PokéManager API",
    "description": "API para gerenciamento de catálogo de Pokémon"
  },
  "servers": [
    {
      "url": "http://localhost:3333/"
    }
  ],
  "tags": [
    {
      "name": "Pokemons",
      "description": "Endpoints de gerenciamento de Pokémon"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Lista os Pokémon",
        "description": "Retorna todos os Pokémon cadastrados no catálogo.",
        "responses": {
          "200": {
            "description": "Lista de Pokémon retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Pokemon"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Cadastra um novo Pokémon",
        "description": "Adiciona um novo Pokémon ao catálogo.",
        "responses": {
          "201": {
            "description": "Pokémon cadastrado com sucesso"
          },
          "400": {
            "description": "Dados inválidos ou ID já cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePokemonDto"
              }
            }
          }
        }
      }
    },
    "/{id}": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Busca um Pokémon por ID",
        "description": "Retorna um Pokémon específico a partir do seu ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon encontrado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pokemon"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza um Pokémon",
        "description": "Atualiza completamente os dados de um Pokémon existente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon atualizado com sucesso"
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePokemonDto"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Remove um Pokémon",
        "description": "Remove um Pokémon do catálogo pelo ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "204": {
            "description": "Pokémon removido com sucesso"
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza parcialmente um Pokémon",
        "description": "Atualiza apenas os campos informados de um Pokémon existente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon atualizado parcialmente com sucesso"
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchPokemonDto"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pokemon": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "25"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "Electric"
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          }
        }
      },
      "CreatePokemonDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "25"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "Electric"
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "hp",
          "attack",
          "defense"
        ]
      },
      "UpdatePokemonDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Pikachu Fortalecido"
          },
          "type": {
            "type": "string",
            "example": "Electric"
          },
          "hp": {
            "type": "number",
            "example": 50
          },
          "attack": {
            "type": "number",
            "example": 65
          },
          "defense": {
            "type": "number",
            "example": 45
          }
        },
        "required": [
          "name",
          "type",
          "hp",
          "attack",
          "defense"
        ]
      },
      "PatchPokemonDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Pikachu Turbo"
          },
          "type": {
            "type": "string",
            "example": "Electric"
          },
          "hp": {
            "type": "number",
            "example": 70
          },
          "attack": {
            "type": "number",
            "example": 75
          },
          "defense": {
            "type": "number",
            "example": 45
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Pokémon não encontrado no catálogo."
          }
        }
      }
    }
  }
}