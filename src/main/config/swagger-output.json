{
  "openapi": "3.0.0",
  "info": {
    "version": "2.0.0",
    "title": "PokéManager API",
    "description": "API para gerenciamento de Pokémon, treinadores e capturas, integrada à PokéAPI oficial."
  },
  "servers": [
    {
      "url": "http://localhost:3333/"
    }
  ],
  "tags": [
    {
      "name": "Pokemons",
      "description": "Catálogo de Pokémon cadastrados no banco"
    },
    {
      "name": "Trainers",
      "description": "Cadastro de treinadores"
    },
    {
      "name": "Pokedex",
      "description": "Pesquisa de Pokémon na PokéAPI oficial"
    },
    {
      "name": "Captures",
      "description": "Captura de Pokémon e equipe dos treinadores"
    }
  ],
  "paths": {},
  "components": {
    "schemas": {
      "Pokemon": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "25"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "ELECTRIC"
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          },
          "level": {
            "type": "number",
            "example": 1
          }
        }
      },
      "CreatePokemonDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "25"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "ELECTRIC"
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          },
          "level": {
            "type": "number",
            "example": 5
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "hp",
          "attack",
          "defense"
        ]
      },
      "UpdatePokemonDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Pikachu Fortalecido"
          },
          "type": {
            "type": "string",
            "example": "ELECTRIC"
          },
          "hp": {
            "type": "number",
            "example": 50
          },
          "attack": {
            "type": "number",
            "example": 65
          },
          "defense": {
            "type": "number",
            "example": 45
          },
          "level": {
            "type": "number",
            "example": 10
          }
        },
        "required": [
          "name",
          "type",
          "hp",
          "attack",
          "defense"
        ]
      },
      "PatchPokemonDto": {
        "type": "object",
        "properties": {
          "hp": {
            "type": "number",
            "example": 70
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "message": {
            "type": "string",
            "example": "Pokémon não encontrado no catálogo."
          }
        }
      }
    }
  }
}