{
  "openapi": "3.0.0",
  "info": {
    "version": "2.0.0",
    "title": "PokéManager API",
    "description": "API para gerenciamento de Pokémon, treinadores e capturas, integrada à PokéAPI oficial."
  },
  "servers": [
    {
      "url": "http://localhost:3333/"
    }
  ],
  "tags": [
    {
      "name": "Pokemons",
      "description": "Catálogo de Pokémon cadastrados no banco"
    },
    {
      "name": "Trainers",
      "description": "Cadastro de treinadores"
    },
    {
      "name": "Pokedex",
      "description": "Pesquisa de Pokémon na PokéAPI oficial"
    },
    {
      "name": "Captures",
      "description": "Captura de Pokémon e equipe dos treinadores"
    }
  ],
  "paths": {
    "/api/v1/pokemons/": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Lista os Pokémon",
        "description": "Retorna todos os Pokémon cadastrados no catálogo.",
        "parameters": [
          {
            "name": "parse(req",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de Pokémon retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Pokemon"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Cadastra um novo Pokémon",
        "description": "Adiciona um novo Pokémon ao catálogo.",
        "parameters": [
          {
            "name": "parse(req",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Pokémon cadastrado com sucesso"
          },
          "400": {
            "description": "Dados inválidos ou ID já cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePokemonDto"
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons/{id}": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Busca um Pokémon por ID",
        "description": "Retorna um Pokémon específico a partir do seu ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID numérico do Pokémon",
            "example": 1
          },
          {
            "name": "parse(req",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon encontrado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pokemon"
                }
              }
            }
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza um Pokémon",
        "description": "Atualiza completamente os dados de um Pokémon existente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID numérico do Pokémon",
            "example": 1
          },
          {
            "name": "parse(req",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon atualizado com sucesso"
          },
          "400": {
            "description": "ID ou dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePokemonDto"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Remove um Pokémon",
        "description": "Remove um Pokémon do catálogo pelo ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID numérico do Pokémon",
            "example": 1
          },
          {
            "name": "parse(req",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Pokémon removido com sucesso"
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "parse(req": {
                    "example": "any"
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza parcialmente um Pokémon",
        "description": "Atualiza apenas os campos informados de um Pokémon existente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID numérico do Pokémon",
            "example": 1
          },
          {
            "name": "parse(req",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon atualizado parcialmente com sucesso"
          },
          "400": {
            "description": "ID ou dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchPokemonDto"
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons/{id}/level": {
      "patch": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza o nível de um Pokémon",
        "description": "Atualiza somente o nível de um Pokémon existente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID numérico do Pokémon",
            "example": 1
          },
          {
            "name": "parse(req",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Nível atualizado com sucesso"
          },
          "400": {
            "description": "ID ou nível inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "level"
                ],
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "example": 10,
                    "description": "Novo nível do Pokémon"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/": {
      "post": {
        "tags": [
          "Trainers"
        ],
        "summary": "Cadastra um novo treinador",
        "description": "Adiciona um treinador ao banco de dados. O ID é gerado automaticamente pelo PostgreSQL.",
        "parameters": [
          {
            "name": "parse(req",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Treinador cadastrado com sucesso"
          },
          "409": {
            "description": "Já existe um treinador cadastrado com este e-mail"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "city"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Ash Ketchum"
                  },
                  "email": {
                    "type": "string",
                    "example": "ash@example.com"
                  },
                  "city": {
                    "type": "string",
                    "example": "Pallet"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/{id}": {
      "get": {
        "tags": [
          "Trainers"
        ],
        "summary": "Busca um treinador por ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "UUID do treinador",
            "format": "uuid"
          },
          {
            "name": "parse(req",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Treinador encontrado com sucesso"
          },
          "400": {
            "description": "UUID inválido"
          },
          "404": {
            "description": "Treinador não encontrado"
          }
        }
      },
      "put": {
        "tags": [
          "Trainers"
        ],
        "summary": "Atualiza um treinador",
        "description": "Atualiza o nome, e-mail e cidade de um treinador existente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "UUID do treinador",
            "format": "uuid"
          },
          {
            "name": "parse(req",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Treinador atualizado com sucesso"
          },
          "400": {
            "description": "UUID ou dados inválidos"
          },
          "404": {
            "description": "Treinador não encontrado"
          },
          "409": {
            "description": "Já existe um treinador cadastrado com este e-mail"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "city"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Ash Ketchum"
                  },
                  "email": {
                    "type": "string",
                    "example": "ash.updated@example.com"
                  },
                  "city": {
                    "type": "string",
                    "example": "Viridian"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Trainers"
        ],
        "summary": "Exclui um treinador",
        "description": "Remove um treinador cadastrado pelo seu UUID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "UUID do treinador",
            "format": "uuid"
          },
          {
            "name": "parse(req",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Treinador excluído com sucesso"
          },
          "400": {
            "description": "UUID inválido"
          },
          "404": {
            "description": "Treinador não encontrado"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "parse(req": {
                    "example": "any"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pokedex/search": {
      "get": {
        "tags": [
          "Pokedex"
        ],
        "summary": "Pesquisa um Pokémon",
        "description": "Pesquisa um Pokémon pelo nome na PokéAPI oficial.",
        "parameters": [
          {
            "name": "parse(req",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Nome do Pokémon que deseja pesquisar",
            "required": true,
            "example": "pikachu",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon encontrado com sucesso"
          },
          "400": {
            "description": "Nome inválido ou não informado"
          },
          "404": {
            "description": "Pokémon não encontrado na PokéAPI"
          }
        }
      }
    },
    "/api/v1/trainers/{trainerId}/captures": {
      "post": {
        "tags": [
          "Captures"
        ],
        "summary": "Captura um Pokémon",
        "description": "Busca o Pokémon na PokéAPI oficial e registra a captura na equipe do treinador. Cada treinador pode ter no máximo 6 Pokémon.",
        "parameters": [
          {
            "name": "trainerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "UUID do treinador",
            "format": "uuid"
          },
          {
            "name": "parse(req",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Pokémon capturado com sucesso"
          },
          "400": {
            "description": "Dados de entrada inválidos"
          },
          "404": {
            "description": "Treinador ou Pokémon não encontrado"
          },
          "409": {
            "description": "O treinador já possui seis Pokémon na equipe"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "pokemonName"
                ],
                "properties": {
                  "pokemonName": {
                    "type": "string",
                    "example": "pikachu"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/{trainerId}/team": {
      "get": {
        "tags": [
          "Captures"
        ],
        "summary": "Lista a equipe de um treinador",
        "description": "Retorna os Pokémon capturados pelo treinador (no máximo 6).",
        "parameters": [
          {
            "name": "trainerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "UUID do treinador",
            "format": "uuid"
          },
          {
            "name": "parse(req",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Equipe retornada com sucesso"
          },
          "400": {
            "description": "UUID inválido"
          },
          "404": {
            "description": "Treinador não encontrado"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pokemon": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "25"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "ELECTRIC"
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          },
          "level": {
            "type": "number",
            "example": 1
          }
        }
      },
      "CreatePokemonDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "25"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "ELECTRIC"
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          },
          "level": {
            "type": "number",
            "example": 5
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "hp",
          "attack",
          "defense"
        ]
      },
      "UpdatePokemonDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Pikachu Fortalecido"
          },
          "type": {
            "type": "string",
            "example": "ELECTRIC"
          },
          "hp": {
            "type": "number",
            "example": 50
          },
          "attack": {
            "type": "number",
            "example": 65
          },
          "defense": {
            "type": "number",
            "example": 45
          },
          "level": {
            "type": "number",
            "example": 10
          }
        },
        "required": [
          "name",
          "type",
          "hp",
          "attack",
          "defense"
        ]
      },
      "PatchPokemonDto": {
        "type": "object",
        "properties": {
          "hp": {
            "type": "number",
            "example": 70
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "message": {
            "type": "string",
            "example": "Pokémon não encontrado no catálogo."
          }
        }
      }
    }
  }
}